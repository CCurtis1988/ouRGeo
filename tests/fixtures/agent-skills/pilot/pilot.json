 {
  "id": "env-move-01",
  "domains": [
   "environments"
  ],
  "modules": [
   "action:env:*",
   "topic:interface"
  ],
  "fixture": {
   "r": "nc <- sf::st_read(system.file('shape/nc.shp', package = 'sf'), quiet = TRUE)"
  },
  "turns": [
   {
    "user": "Create an environment called scratch2 and move nc into it."
   }
  ],
  "graders": [
   {
    "r_state": "exists('scratch2', envir = globalenv(), inherits = FALSE) && is.environment(get('scratch2', envir = globalenv())) && exists('nc', envir = get('scratch2', envir = globalenv()), inherits = FALSE) && !exists('nc', envir = globalenv(), inherits = FALSE)"
   }
  ],
  "reference": {
   "steps": [
    {
     "action": "env:create",
     "params": {
      "name": "scratch2"
     }
    },
    {
     "action": "env:move",
     "params": {
      "name": "nc",
      "to": "scratch2"
     }
    }
   ],
   "answer": "Created scratch2 and moved nc into it."
  },
  "wrong": {
   "steps": [
    {
     "r": "scratch2 <- new.env()"
    }
   ],
   "answer": "Done."
  },
  "probe": {
   "tool": "run_ui_action",
   "where": "i.id === 'env:create'"
  }
 },
