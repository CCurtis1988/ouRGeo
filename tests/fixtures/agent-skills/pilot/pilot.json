 {
  "id": "r-count-01",
  "domains": [
   "r-provenance"
  ],
  "modules": [
   "contract",
   "tool:execute_r_code"
  ],
  "fixture": {
   "r": "nc <- sf::st_read(system.file('shape/nc.shp', package = 'sf'), quiet = TRUE)"
  },
  "turns": [
   {
    "user": "How many counties in nc had more than 10,000 births in 1974 (column BIR74)?"
   }
  ],
  "graders": [
   {
    "tool_called": "execute_r_code"
   },
   {
    "answer_regex": "\\b6\\b"
   },
   {
    "numbers_grounded": true
   }
  ],
  "reference": {
   "steps": [
    {
     "r": "sum(nc$BIR74 > 10000)"
    }
   ],
   "answer": "6 counties had more than 10,000 births in 1974 (`sum(nc$BIR74 > 10000)`)."
  },
  "wrong": {
   "steps": [],
   "answer": "7 counties had more than 10,000 births in 1974."
  },
  "probe": {
   "tool": "execute_r_code",
   "where": "/BIR74/.test(i.code)"
  }
 },
 {
  "id": "r-autopilot-off-01",
  "domains": [
   "autopilot-off"
  ],
  "modules": [
   "contract"
  ],
  "switches": {
