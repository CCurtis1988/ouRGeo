  },
  "wrong": {
   "steps": [],
   "answer": "The mean AREA is 0.1263."
  },
  "probe": {
   "tool": "none"
  }
 },
 {
  "id": "r-transform-01",
  "domains": [
   "r-provenance"
  ],
  "modules": [
   "contract",
   "tool:execute_r_code"
  ],
  "fixture": {
   "r": "nc <- sf::st_read(system.file('shape/nc.shp', package = 'sf'), quiet = TRUE)"
  },
  "turns": [
   {
    "user": "Reproject nc to NAD83 / North Carolina (EPSG:32119) and keep the result as nc_sp."
   }
  ],
  "graders": [
   {
    "r_state": "inherits(nc_sp, 'sf') && sf::st_crs(nc_sp)$epsg == 32119 && nrow(nc_sp) == 100"
   }
  ],
  "reference": {
   "steps": [
    {
     "r": "nc_sp <- sf::st_transform(nc, 32119)"
    }
   ],
   "answer": "nc_sp is nc in EPSG:32119."
  },
  "wrong": {
   "steps": [
    {
     "r": "nc_sp <- sf::st_transform(nc, 4326)"
    }
   ],
   "answer": "nc_sp is nc in EPSG:32119."
  },
  "probe": {
   "tool": "execute_r_code",
   "where": "/32119/.test(i.code)"
  }
 },
 {
  "id": "toolbox-buffer-01",
  "domains": [
   "toolbox"
  ],
  "modules": [
   "tool:run_toolbox_tool",
   "toolbox:sf-buffer",
   "topic:toolbox"
  ],
  "fixture": {
   "r": "nc <- sf::st_transform(sf::st_read(system.file('shape/nc.shp', package = 'sf'), quiet = TRUE), 32119)"
  },
  "turns": [
   {
    "user": "Use the Toolbox to buffer nc by 1000 metres and call the result nc_buf."
   }
  ],
  "graders": [
   {
    "tool_called": "run_toolbox_tool"
   },
   {
    "r_state": "inherits(nc_buf, 'sf') && nrow(nc_buf) == 100 && all(as.numeric(sf::st_area(nc_buf)) > as.numeric(sf::st_area(nc)))"
   }
  ],
  "reference": {
   "steps": [
    {
     "tool": "run_toolbox_tool",
     "input": {
      "toolId": "sf-buffer"
     },
     "result": "ran"
    },
    {
     "r": "nc_buf <- sf::st_buffer(nc, dist = 1000)"
    }
   ],
   "answer": "nc_buf holds the 1000 m buffers."
  },
  "wrong": {
   "steps": [
    {
     "r": "nc_buf <- nc"
    }
   ],
   "answer": "Buffered."
  },
  "probe": {
   "tool": "run_toolbox_tool",
   "where": "i.toolId === 'sf-buffer' || i.toolId === 'geos-buffer'",
   "discovery": [
    "toolbox_tools",
    "context_search",
    "ourgeo_docs"
   ]
  }
 },
 {
  "id": "doc-rmd-01",
  "domains": [
   "documents"
  ],
  "modules": [
   "documentSkill",
   "topic:documents",
   "tool:write_document"
  ],
  "fixture": {
   "r": "nc <- sf::st_read(system.file('shape/nc.shp', package = 'sf'), quiet = TRUE)",
   "documents": [
    {
     "fileName": "report.Rmd",
     "content": "",
     "language": "rmarkdown"
    }
   ]
  },
  "turns": [
   {
    "user": "Write an R Markdown report in report.Rmd that maps the nc counties coloured by BIR74 and states how many counties there are."
   }
  ],
  "graders": [
   {
    "knits": "report.Rmd"
   },
   {
    "app_state": "/st_read|readRDS|source\\(/.test(s.tabs.find(t => t.fileName === 'report.Rmd')?.content ?? '')"
   }
  ],
  "reference": {
   "steps": [
    {
     "document": "---\ntitle: \"NC births\"\noutput: html_document\n---\n\n```{r setup, include=FALSE}\nlibrary(sf)\nlibrary(ggplot2)\n```\n\n```{r load}\nnc <- st_read(system.file('shape/nc.shp', package = 'sf'), quiet = TRUE)\n```\n\nThere are `r nrow(nc)` counties.\n\n```{r map}\nggplot(nc) + geom_sf(aes(fill = BIR74))\n```\n"
    }
   ],
   "answer": "Written to report.Rmd."
  },
  "wrong": {
   "steps": [
    {
     "document": "---\ntitle: \"NC births\"\noutput: html_document\n---\n\nThere are `r nrow(nc)` counties.\n\n```{r map}\nplot(nc['BIR74'])\n```\n"
    }
   ],
   "answer": "Written to report.Rmd."
  },
  "probe": {
   "tool": "write_document",
   "discovery": [
    "read_document",
    "context_search",
    "ourgeo_docs"
   ]
  }
 },
