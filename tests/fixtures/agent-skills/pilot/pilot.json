 {
  "id": "failure-missing-01",
  "domains": [
   "failure-recovery"
  ],
  "modules": [
   "contract",
   "action:map:addLayer"
  ],
  "fixture": {
   "r": "nc <- sf::st_read(system.file('shape/nc.shp', package = 'sf'), quiet = TRUE)"
  },
  "turns": [
   {
    "user": "Add the layer counties_2020 to the map."
   }
  ],
  "graders": [
   {
    "r_state": "!exists('counties_2020')"
   },
   {
    "app_state": "!s.layers.some(l => l.name === 'counties_2020')"
   },
   {
    "answer_regex": "(no|not|couldn|can.t|doesn|isn)"
   }
  ],
  "reference": {
   "steps": [
    {
     "action": "map:addLayer",
     "params": {
      "object": "counties_2020"
     }
    }
   ],
   "answer": "There's no object called counties_2020 in your session; the spatial object available is nc."
  },
  "wrong": {
   "steps": [
    {
     "r": "counties_2020 <- nc"
    },
    {
     "action": "map:addLayer",
     "params": {
      "object": "counties_2020"
     }
    }
   ],
   "answer": "Added counties_2020."
  },
  "probe": {
   "tool": "run_ui_action",
   "discovery": [
    "list_ui_actions",
    "context_search",
    "execute_r_code"
   ]
  }
 },
 {
