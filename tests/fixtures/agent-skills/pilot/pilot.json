[
 {
  "id": "map-add-01",
  "domains": [
   "maps"
  ],
  "modules": [
   "action:map:*",
   "topic:maps"
  ],
  "fixture": {
   "r": "nc <- sf::st_read(system.file('shape/nc.shp', package = 'sf'), quiet = TRUE)"
  },
  "turns": [
   {
    "user": "Add nc to the map."
   }
  ],
  "graders": [
   {
    "app_state": "s.layers.some(l => l.name === 'nc')"
   }
  ],
  "reference": {
   "steps": [
    {
     "action": "map:addLayer",
     "params": {
      "object": "nc"
     }
    }
   ],
   "answer": "Added nc to the map."
  },
  "wrong": {
   "steps": [],
   "answer": "Added nc to the map."
  },
  "probe": {
   "tool": "run_ui_action",
   "where": "i.id === 'map:addLayer' && i.params?.object === 'nc'"
  }
 },
 {
  "id": "map-colour-01",
