 {
  "id": "r-provenance-train-wells-in-site-01",
  "domains": [
   "r-provenance"
  ],
  "modules": [
   "tool:execute_r_code",
   "topic:r"
  ],
  "switches": {
   "autopilot": true,
   "web": false,
   "terminal": false
  },
  "confirm": "approve",
  "fixture": {
   "r": "site <- sf::st_sf(name = \"site\", geometry = sf::st_sfc(sf::st_polygon(list(rbind(c(0, 0), c(10, 0), c(10, 10), c(0, 10), c(0, 0)))), crs = 3857))\nwells <- sf::st_sf(id = 1:7, geometry = sf::st_sfc(lapply(list(c(1, 1), c(5, 5), c(9, 2), c(12, 3), c(15, 15), c(3, 8), c(11, 11)), sf::st_point), crs = 3857))",
   "layers": [
    "site",
    "wells"
   ],
   "documents": []
  },
  "turns": [
   {
    "user": "I've got a wells layer and a site boundary on the map. Can you work out how many of the wells actually fall inside the site?"
   }
  ],
  "graders": [
   {
    "tool_called": "execute_r_code"
   },
   {
    "answer_regex": "\\b4\\b|\\bfour\\b"
   },
   {
    "numbers_grounded": true
   },
   {
    "r_state": "exists(\"wells\", envir = globalenv()) && nrow(get(\"wells\", envir = globalenv())) == 7"
   }
  ],
  "reference": {
   "steps": [
    {
     "r": "sum(lengths(sf::st_intersects(wells, site)) > 0)"
    }
   ],
   "answer": "4 of the wells fall inside the site boundary."
  },
  "wrong": {
   "steps": [
    {
     "r": "length(sf::st_intersects(wells, site))"
    }
   ],
   "answer": "All 7 wells fall inside the site boundary."
  }
 },
