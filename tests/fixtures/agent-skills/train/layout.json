   }
  ],
  "graders": [
   {
    "tool_called": {
     "name": "run_ui_action",
     "where": "i.id === 'layout:dockPanel' && ((i.params.panel === 'console' && i.params.target === 'editor' && i.params.placement === 'right') || (i.params.panel === 'editor' && i.params.target === 'console' && i.params.placement === 'left'))"
    }
   }
  ],
  "reference": {
   "steps": [
    {
     "action": "layout:dockPanel",
     "params": {
      "panel": "console",
      "target": "editor",
      "placement": "right"
     }
    }
   ],
   "answer": "The console now sits to the right of the code editor in a side-by-side split."
  },
  "wrong": {
   "steps": [
    {
     "action": "layout:dockPanel",
     "params": {
      "panel": "console",
      "target": "editor",
      "placement": "bottom"
     }
    }
   ],
   "answer": "The console is now docked with the code editor."
  },
  "probe": {
   "tool": "run_ui_action",
   "where": "i.id === 'layout:dockPanel'"
  }
 },
 {
