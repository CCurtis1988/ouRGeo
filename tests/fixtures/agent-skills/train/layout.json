 {
  "id": "layout-train-map-left-sizing-01",
  "domains": [
   "layout"
  ],
  "modules": [
   "action:layout:movePanel",
   "action:layout:setZoneSize",
   "action:layout:setPanelSize",
   "topic:layout"
  ],
  "switches": {
   "autopilot": true,
   "web": false,
   "terminal": false
  },
  "confirm": "approve",
  "fixture": {
   "r": "nc <- sf::st_read(system.file(\"shape/nc.shp\", package = \"sf\"), quiet = TRUE)",
   "layers": [
    "nc"
   ]
  },
  "turns": [
   {
    "user": "Please move the map into the left column, make that column 600 pixels wide, and give the map 70% of the column."
   }
  ],
  "graders": [
   {
    "tool_called": {
     "name": "run_ui_action",
     "where": "i.id === 'layout:movePanel' && /spatial|map/i.test(String(i.params.panel)) && i.params.zone === 'left'"
    }
   },
   {
    "tool_called": {
     "name": "run_ui_action",
     "where": "i.id === 'layout:setZoneSize' && i.params.zone === 'left' && Number(i.params.size) === 600"
    }
   },
   {
    "tool_called": {
     "name": "run_ui_action",
     "where": "i.id === 'layout:setPanelSize' && /spatial|map/i.test(String(i.params.panel)) && Number(i.params.percent) === 70"
    }
   }
  ],
  "reference": {
   "steps": [
    {
     "action": "layout:movePanel",
     "params": {
      "panel": "spatial",
      "zone": "left"
     }
    },
    {
     "action": "layout:setZoneSize",
     "params": {
      "zone": "left",
      "size": 600
     }
    },
    {
     "action": "layout:setPanelSize",
     "params": {
      "panel": "spatial",
      "percent": 70
     }
    }
   ],
   "answer": "The map is now in the left column. I set the column to 600 pixels wide and requested 70% of its space for the map."
  },
  "wrong": {
   "steps": [
    {
     "action": "layout:movePanel",
     "params": {
      "panel": "spatial",
      "zone": "left"
     }
    },
    {
     "action": "layout:setPanelSize",
     "params": {
      "panel": "spatial",
      "percent": 70
     }
    }
   ],
   "answer": "The map is now in the left column and takes up 70% of it."
  },
  "probe": {
   "tool": "run_ui_action",
   "where": "i.id === 'layout:movePanel' || i.id === 'layout:setZoneSize' || i.id === 'layout:setPanelSize'"
  }
 }
]