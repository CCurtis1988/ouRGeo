[
 {
  "id": "layout-train-right-zone-tabs-chatty-01",
  "domains": [
   "layout"
  ],
  "modules": [
   "action:layout:setZoneMode",
   "topic:layout"
  ],
  "switches": {
   "autopilot": true,
   "web": false,
   "terminal": false
  },
  "confirm": "approve",
  "fixture": {
   "r": "invisible(NULL)"
  },
  "turns": [
   {
    "user": "The panels in my right column are all squashed together, and I can barely read any of them. I'd love each one to get the full height, one at a time, but I don't want to close anything. Can you sort that out?"
   }
  ],
  "graders": [
   {
    "tool_called": {
     "name": "run_ui_action",
     "where": "i.id === 'layout:setZoneMode' && i.params.zone === 'right' && i.params.mode === 'tabs'"
    }
   }
  ],
  "reference": {
   "steps": [
    {
     "action": "layout:setZoneMode",
     "params": {
      "zone": "right",
      "mode": "tabs"
     }
    }
   ],
   "answer": "The right column now shows its panels behind tabs, so each one gets the full height and nothing was closed."
  },
  "wrong": {
   "steps": [
    {
     "action": "ui:panel",
     "params": {
      "panel": "help",
      "state": "close"
     }
    }
   ],
   "answer": "I closed the Help panel so the remaining panels in the right column have more room."
  },
  "probe": {
   "tool": "run_ui_action",
   "where": "i.id === 'layout:setZoneMode'"
  }
 },
 {
  "id": "layout-train-console-beside-editor-typo-01",
  "domains": [
   "layout"
  ],
  "modules": [
   "action:layout:dockPanel",
   "topic:layout"
  ],
  "switches": {
   "autopilot": true,
   "web": false,
   "terminal": false
  },
  "confirm": "approve",
  "fixture": {
   "r": "invisible(NULL)"
  },
  "turns": [
   {
