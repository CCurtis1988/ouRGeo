 {
  "id": "tutorials-val-add-to-map-viewer-typo-01",
  "domains": [
   "tutorials"
  ],
  "modules": [
   "action:ui:highlight",
   "action:env:view",
   "topic:tutorials"
  ],
  "switches": {
   "autopilot": true,
   "web": false,
   "terminal": false
  },
  "confirm": "approve",
  "fixture": {
   "r": "nc <- sf::st_read(system.file(\"shape/nc.shp\", package = \"sf\"), quiet = TRUE)",
   "layers": []
  },
  "turns": [
   {
    "user": "were is the add to map buton in the data viewer? i want to put nc on the map myself so dont do it for me"
   }
  ],
  "graders": [
   {
    "tool_called": {
     "name": "run_ui_action",
     "where": "i.id === 'env:view' && (i.params || i).name === 'nc'"
    }
   },
   {
    "tool_called": {
     "name": "run_ui_action",
     "where": "i.id === 'ui:highlight' && (i.params || i).target === 'dataViewer.addToMap'"
    }
   },
   {
    "app_state": "s.layers.length === 0"
   }
  ],
  "reference": {
   "steps": [
    {
     "tool": "run_ui_action",
     "input": {
      "id": "env:view",
      "params": {
       "name": "nc"
      }
     },
     "result": "Opened nc in the Data Viewer."
    },
    {
     "tool": "run_ui_action",
     "input": {
      "id": "ui:highlight",
      "params": {
       "target": "dataViewer.addToMap",
       "message": "Click Add to Map to send nc to the map."
      }
     },
     "result": "Highlighted dataViewer.addToMap."
    }
   ],
   "answer": "I've opened nc in the Data Viewer and highlighted Add to Map in its header. Click it when you're ready. I haven't added the layer."
  },
  "wrong": {
