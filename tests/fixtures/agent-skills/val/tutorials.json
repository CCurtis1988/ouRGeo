    {
     "action": "map:addLayer",
     "params": {
      "object": "nc"
     }
    }
   ],
   "answer": "I've added nc to the map for you."
  },
  "probe": {
   "tool": "run_ui_action",
   "where": "i.id === 'ui:highlight'"
  }
 },
