   "autopilot": true,
   "web": false,
   "terminal": false
  },
  "confirm": "approve",
  "fixture": {
   "r": "write.csv(head(datasets::quakes, 50), \"field_sites.csv\", row.names = FALSE)"
  },
  "turns": [
   {
    "user": "Hi! I've got a CSV called field_sites.csv in my working folder, and I really want to learn how to do this myself. Please don't import it for me, just show me which button I should click to get started."
   }
  ],
  "graders": [
   {
    "tool_called": {
     "name": "run_ui_action",
     "where": "i.id === 'ui:highlight' && (i.params || i).target === 'toolbar.loadData'"
    }
   },
   {
    "r_state": "!any(vapply(ls(envir = globalenv()), function(n) is.data.frame(get(n, envir = globalenv())), logical(1)))"
   }
  ],
  "reference": {
   "steps": [
    {
     "tool": "run_ui_action",
     "input": {
      "id": "ui:highlight",
