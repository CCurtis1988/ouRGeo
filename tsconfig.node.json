{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "electron-vite.config.*",
    "electron/**/*",
    // Pure helpers shared with the main process. They live under src/ so the
    // renderer's Vitest suite covers them; the main process imports them.
    "src/lib/markdown/knit-errors.ts",
    "src/lib/terminal/shells.ts",
    "src/lib/ai-claude-args.ts",
    "src/lib/ai-fetch-error.ts",
    "src/lib/app-permissions.ts",
    "src/lib/session-scoped-files.ts",
    "src/lib/project-draft-types.ts",
    "src/lib/health-policy.ts",
    "src/lib/context/types.ts",
    "src/lib/project-files.ts",
    "src/lib/project-file-targets.ts",
    "src/lib/theme-backgrounds-types.ts",
    "src/lib/context/providers/contributions.ts",
    "src/lib/context/skills.ts",
    "src/lib/context/sources/plugin.ts",
    "src/lib/plugins/app-version.ts",
    "src/lib/context/folders.ts",
    "src/lib/context/document-range.ts",
    "src/lib/context/column-policy.ts",
    "src/lib/context/column-disclosure.ts",
    "src/lib/context/storage-recovery.ts",
    "src/lib/context/policy.ts",
    "src/lib/context/exclusions.ts",
    "src/lib/context/budget.ts",
    "src/lib/context/usage.ts",
    "src/lib/context/inference-usage.ts",
    "src/lib/context/chat-budget.ts",
    "src/lib/context/providers/types.ts",
    "src/lib/context/providers/maintenance.ts",
    "src/lib/context/providers/validation.ts",
    "src/lib/context/providers/connections.ts",
    "src/lib/context/providers/runtimes.ts",
    "src/lib/context/providers/outbox.ts",
    "src/lib/context/providers/activation.ts",
    "src/lib/context/providers/migration.ts",
    "src/lib/context/providers/recall.ts",
    "src/lib/context/providers/conformance.ts",
    "src/lib/context/memory-schema.ts",
    "src/lib/context/retention.ts",
    "src/lib/context/learning.ts",
    "src/lib/context/preferences.ts",
    "src/lib/context/router.ts",
    "src/lib/health-types.ts",
    "src/lib/app-updates.ts",
    "src/lib/data-preflight-types.ts",
    "src/lib/plugins/archive-policy.ts",
    "src/lib/plugins/store-origin.ts",
    "src/lib/plugins/service-policy.ts",
    "src/lib/plugins/permission-policy.ts"
  ]
}
