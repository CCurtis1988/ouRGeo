{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "electron-vite.config.*",
    "electron/**/*",
    // Pure helpers shared with the main process. They live under src/ so the
    // renderer's Vitest suite covers them; the main process imports them.
    "src/lib/markdown/knit-errors.ts",
    "src/lib/terminal/shells.ts",
    "src/lib/ai-claude-args.ts",
    "src/lib/ai-fetch-error.ts",
    "src/lib/app-permissions.ts",
    "src/lib/session-scoped-files.ts",
    "src/lib/health-policy.ts",
    "src/lib/context/types.ts",
    "src/lib/context/policy.ts",
    "src/lib/context/exclusions.ts",
    "src/lib/context/budget.ts",
    "src/lib/context/usage.ts",
    "src/lib/context/providers/types.ts",
    "src/lib/context/providers/connections.ts",
    "src/lib/context/providers/runtimes.ts",
    "src/lib/context/providers/outbox.ts",
    "src/lib/context/memory-schema.ts",
    "src/lib/context/learning.ts",
    "src/lib/context/preferences.ts",
    "src/lib/context/router.ts",
    "src/lib/health-types.ts",
    "src/lib/data-preflight-types.ts",
    "src/lib/plugins/archive-policy.ts",
    "src/lib/plugins/store-origin.ts",
    "src/lib/plugins/service-policy.ts"
  ]
}
