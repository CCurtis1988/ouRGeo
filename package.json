{
  "name": "ourgeo",
  "version": "1.12.1",
  "description": "R code editor and console powered by Electron",
  "main": "./out/main/index.js",
  "author": "ouRGeo Contributors",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://ourgeo.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CCurtis1988/ouRGeo.git"
  },
  "bugs": {
    "url": "https://ourgeo.dev/forum.html"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:linux": "electron-vite build && electron-builder --linux",
    "package:win": "electron-vite build && electron-builder --win",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit tsconfig.node.json tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@milkdown/kit": "^7.22.1",
    "@milkdown/react": "^7.22.1",
    "@monaco-editor/react": "^4.6.0",
    "@prosemirror-adapter/react": "^0.5.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@turf/helpers": "^7.3.5",
    "@turf/line-offset": "^7.3.5",
    "adm-zip": "^0.6.0",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "esbuild-wasm": "^0.25.12",
    "flatbush": "^4.6.2",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.441.0",
    "maplibre-gl": "^4.7.1",
    "monaco-editor": "0.55.1",
    "react": "^18.3.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.3.0",
    "react-map-gl": "^7.1.9",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwind-merge": "^2.5.0",
    "unified": "^11.0.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@huggingface/transformers": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "org.ourgeo.app",
    "productName": "ouRGeo",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "r/**/*"
    ],
    "extraResources": [
      {
        "from": "r",
        "to": "r",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "maintainer": "ouRGeo Contributors <maintainers@ourgeo.app>",
      "synopsis": "Desktop spatial IDE powered by R",
      "description": "An open-source desktop spatial IDE that wraps R's spatial ecosystem (sf, terra, ggplot2, tmap) in a dark-mode GUI. Requires R to be installed on the system."
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ouRGeo uses the microphone only when you press the microphone button, to transcribe what you say into the AI assistant\u2019s message box."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
